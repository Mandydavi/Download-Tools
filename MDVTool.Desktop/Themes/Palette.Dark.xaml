<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         调色板：深色（v3）
         层级：Bg #0A0E15 < Surface2 #161C27 < Surface3 #1D2431
         不靠「加深」区分层级，靠三级表面 + 1px 描边
         ============================================================ -->

    <!-- 表面 -->
    <SolidColorBrush x:Key="Bg" Color="#0A0E15"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#111620"/>
    <SolidColorBrush x:Key="Card" Color="#111620"/>
    <SolidColorBrush x:Key="CardHover" Color="#161C27"/>
    <SolidColorBrush x:Key="CardSel" Color="#1A2334"/>
    <SolidColorBrush x:Key="Surface2" Color="#161C27"/>
    <SolidColorBrush x:Key="Surface3" Color="#1D2431"/>

    <!-- 描边 -->
    <SolidColorBrush x:Key="Border" Color="#222A37"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#1A212C"/>
    <SolidColorBrush x:Key="BorderHover" Color="#313B4C"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text" Color="#E9EFF9"/>
    <SolidColorBrush x:Key="Sub" Color="#9DABC0"/>
    <SolidColorBrush x:Key="Dim" Color="#6E7D93"/>
    <SolidColorBrush x:Key="Text3" Color="#6E7D93"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9DABC0"/>
    <SolidColorBrush x:Key="Faint" Color="#313B4C"/>

    <!-- 品牌色 -->
    <SolidColorBrush x:Key="Accent" Color="#6E8DFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8AA3FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1C2743"/>
    <SolidColorBrush x:Key="AccentDisabled" Color="#2C3B5E"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#1C2743"/>
    <SolidColorBrush x:Key="AccentRing" Color="#406E8DFF"/>

    <!-- 状态色（文字） -->
    <SolidColorBrush x:Key="Green" Color="#5BD68C"/>
    <SolidColorBrush x:Key="Red" Color="#F2705F"/>
    <SolidColorBrush x:Key="Amber" Color="#E8A648"/>

    <!-- 状态色（底色，半透明让卡片层次透出来） -->
    <SolidColorBrush x:Key="SuccessSoft" Color="#1F5BD68C"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1FF2705F"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1FE8A648"/>

    <!-- 文件类型徽章：半透明浅底 + 亮字 -->
    <SolidColorBrush x:Key="TypeSft" Color="#9BB4FF"/>
    <SolidColorBrush x:Key="TypeSftSoft" Color="#1F9BB4FF"/>
    <SolidColorBrush x:Key="TypeCkpt" Color="#BFA3FF"/>
    <SolidColorBrush x:Key="TypeCkptSoft" Color="#1FBFA3FF"/>
    <SolidColorBrush x:Key="TypeGguf" Color="#5BD3E5"/>
    <SolidColorBrush x:Key="TypeGgufSoft" Color="#1F5BD3E5"/>
    <SolidColorBrush x:Key="TypeMisc" Color="#9DABC0"/>
    <SolidColorBrush x:Key="TypeMiscSoft" Color="#1F9DABC0"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="FieldBg" Color="#111620"/>
    <SolidColorBrush x:Key="GhostBg" Color="#111620"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#161C27"/>
    <SolidColorBrush x:Key="RowHover" Color="#151C28"/>
    <SolidColorBrush x:Key="RowSel" Color="#1A2334"/>
    <SolidColorBrush x:Key="ItemHover" Color="#1D2431"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#161C27"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#12171F"/>

    <SolidColorBrush x:Key="TrackBg" Color="#232B39"/>
    <SolidColorBrush x:Key="ThumbBg" Color="#3A4557"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#313B4C"/>
    <SolidColorBrush x:Key="Knob" Color="#E9EFF9"/>

    <SolidColorBrush x:Key="CloseHover" Color="#E5484D"/>
    <SolidColorBrush x:Key="Scrim" Color="#73000000"/>

    <!-- 注意：Shadow 是 Color 而不是 Brush，DropShadowEffect.Color 只认 Color -->
    <Color x:Key="Shadow">#000000</Color>

</ResourceDictionary>
