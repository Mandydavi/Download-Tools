<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         调色板：浅色（v3）
         层级：Bg #F5F7FA < Surface2 #F4F6FA < Card #FFFFFF
         文字：Text 15.2:1 / Sub 6.4:1 / Dim 3.2:1（仅装饰与图标）
         状态：文字用 700 级深色，底色用 50 级浅色
         ============================================================ -->

    <!-- 表面 -->
    <SolidColorBrush x:Key="Bg" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#F6F9FD"/>
    <SolidColorBrush x:Key="CardSel" Color="#EDF1FF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="Surface3" Color="#EDF1F7"/>

    <!-- 描边 -->
    <SolidColorBrush x:Key="Border" Color="#E6EAF1"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#EFF2F7"/>
    <SolidColorBrush x:Key="BorderHover" Color="#D3DAE6"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text" Color="#0F1A2B"/>
    <SolidColorBrush x:Key="Sub" Color="#53627A"/>
    <SolidColorBrush x:Key="Dim" Color="#8492A6"/>
    <SolidColorBrush x:Key="Text3" Color="#8492A6"/>
    <SolidColorBrush x:Key="TextMuted" Color="#53627A"/>
    <SolidColorBrush x:Key="Faint" Color="#C9D3E0"/>

    <!-- 品牌色 -->
    <SolidColorBrush x:Key="Accent" Color="#2B5CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1B47E0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EDF1FF"/>
    <SolidColorBrush x:Key="AccentDisabled" Color="#B9C6F5"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#EDF1FF"/>
    <!-- 焦点/悬停光晕，只用于 ring，不做填充 -->
    <SolidColorBrush x:Key="AccentRing" Color="#292B5CFF"/>

    <!-- 状态色（文字） -->
    <SolidColorBrush x:Key="Green" Color="#0F7A3D"/>
    <SolidColorBrush x:Key="Red" Color="#C22B1F"/>
    <SolidColorBrush x:Key="Amber" Color="#9A5B00"/>

    <!-- 状态色（底色） -->
    <SolidColorBrush x:Key="SuccessSoft" Color="#E7F6EC"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FCEDEB"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF1DF"/>

    <!-- 文件类型徽章：浅底 + 深字 -->
    <SolidColorBrush x:Key="TypeSft" Color="#1E4FD8"/>
    <SolidColorBrush x:Key="TypeSftSoft" Color="#E9EEFF"/>
    <SolidColorBrush x:Key="TypeCkpt" Color="#6B3FD4"/>
    <SolidColorBrush x:Key="TypeCkptSoft" Color="#F1EBFF"/>
    <SolidColorBrush x:Key="TypeGguf" Color="#0B7285"/>
    <SolidColorBrush x:Key="TypeGgufSoft" Color="#E2F5F8"/>
    <SolidColorBrush x:Key="TypeMisc" Color="#4B5A72"/>
    <SolidColorBrush x:Key="TypeMiscSoft" Color="#EDF1F7"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GhostBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="RowHover" Color="#F7F9FD"/>
    <SolidColorBrush x:Key="RowSel" Color="#EDF1FF"/>
    <SolidColorBrush x:Key="ItemHover" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#F7F9FD"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#FAFBFD"/>

    <SolidColorBrush x:Key="TrackBg" Color="#E9EDF4"/>
    <SolidColorBrush x:Key="ThumbBg" Color="#C7D0DE"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#D3DAE6"/>
    <SolidColorBrush x:Key="Knob" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CloseHover" Color="#E5484D"/>
    <SolidColorBrush x:Key="Scrim" Color="#3D0C1422"/>

    <!-- 注意：Shadow 是 Color 而不是 Brush，DropShadowEffect.Color 只认 Color -->
    <Color x:Key="Shadow">#0F1A2B</Color>

</ResourceDictionary>
