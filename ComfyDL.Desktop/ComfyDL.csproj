<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ComfyDL</AssemblyName>
    <RootNamespace>ComfyDL</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.4.0</Version>
    <Product>ComfyDL 高速下载器</Product>
    <AssemblyTitle>ComfyDL 高速下载器</AssemblyTitle>
    <Company>ComfyDL</Company>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\app-logo.png" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
