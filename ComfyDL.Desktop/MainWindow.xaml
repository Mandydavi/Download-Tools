<Window x:Class="ComfyDL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:ComfyDL.Controls"
        xmlns:local="clr-namespace:ComfyDL"
        Title="极速下载器 · ComfyDL"
        Icon="app.ico"
        Width="1280" Height="800" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Text}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:PathWrapConverter x:Key="PathWrap"/>

        <!-- ============================================================
             v8 · 进行中的任务：大卡片（76px，百分比 23px）
             全界面只有这一种行允许抢注意力
             ============================================================ -->
        <DataTemplate x:Key="RowRunning">
            <Border Height="76" Margin="12,3,12,5" CornerRadius="11" Padding="0"
                    Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Grid>
                    <Grid Margin="14,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}"
                                Width="42" Height="42" CornerRadius="11"
                                TextElement.FontSize="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                            <TextBlock Text="{Binding MetaLine}" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Dim}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DestPath}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Right" Margin="0,0,12,0">
                            <TextBlock Text="{Binding PctText}" FontSize="23" FontWeight="Bold"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SpeedCell}" FontSize="10.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Dim}"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    Style="{StaticResource RowActions}">
                            <Button Style="{StaticResource RowAction}" Click="CancelTask_Click"
                                    ToolTip="停止"
                                    Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                                <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource RowAction}" Click="ResumeTask_Click"
                                    ToolTip="继续"
                                    Visibility="{Binding CanResume, Converter={StaticResource B2V}}">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource RowAction}" Click="OpenTaskFolder_Click"
                                    ToolTip="{Binding FolderHint}">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource RowAction}" Click="RemoveTask_Click"
                                    ToolTip="删除任务">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding Pct, Mode=OneWay}" Maximum="100" Height="4"
                                 Style="{StaticResource ProgressRow}"
                                 VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================================================
             v8 · 等待 / 已完成：紧凑行（44px），已完成整体降权
             ============================================================ -->
        <DataTemplate x:Key="RowCompact">
            <Grid Height="44">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="done">
                                <Setter Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}"
                            Width="26" Height="26" CornerRadius="7"
                            TextElement.FontSize="7.5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                               Margin="11,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>

                    <TextBlock Grid.Column="2" Text="{Binding ShortMeta}" FontSize="10.5"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="3" Text="{Binding PctText}" FontSize="11"
                               Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                Style="{StaticResource RowActions}">
                        <Button Style="{StaticResource RowAction}" Click="CancelTask_Click"
                                ToolTip="停止"
                                Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                            <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="ResumeTask_Click"
                                ToolTip="继续"
                                Visibility="{Binding CanResume, Converter={StaticResource B2V}}">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="OpenTaskFolder_Click"
                                ToolTip="{Binding FolderHint}">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="RemoveTask_Click"
                                ToolTip="删除任务">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{Binding Pct, Mode=OneWay}" Maximum="100" Height="2"
                             Style="{StaticResource ProgressRow}"
                             VerticalAlignment="Bottom" Margin="16,0,12,0"/>
            </Grid>
        </DataTemplate>

        <local:TaskRowSelector x:Key="RowSelector"
                               Running="{StaticResource RowRunning}"
                               Compact="{StaticResource RowCompact}"/>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================
                 标题栏：只留品牌、工具、窗口按钮。链接输入已下移到捕获区
                 ============================================================ -->
            <Grid Grid.Row="0" Background="{DynamicResource Card}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/app-icon.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="极速下载器" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="{DynamicResource Surface3}" CornerRadius="5" Padding="5,1"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadge" Text="v0" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Dim}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconBtn}" Click="OpenModelsDir_Click" ToolTip="打开模型目录">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="NavSettings_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinBtn}" Click="Min_Click" ToolTip="最小化">
                        <Path Data="M0,5 L10,5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="Max_Click" ToolTip="最大化">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Stretch="None"/>
                            <Path x:Name="RestoreIcon" Data="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Stretch="None" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}" Click="Close_Click" ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================
                 图标栏 + 主内容
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 图标栏 ===== -->
                <Border Grid.Column="0" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <RadioButton x:Name="NavTasks" Style="{StaticResource RailItem}" GroupName="Nav"
                                         IsChecked="True" Checked="Nav_Checked" Tag="tasks" ToolTip="队列">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                            </RadioButton>
                            <RadioButton x:Name="NavHistory" Style="{StaticResource RailItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="history" ToolTip="历史">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                            </RadioButton>
                            <RadioButton x:Name="NavFolder" Style="{StaticResource RailItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="folder" ToolTip="模型库">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18"/>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <Border Width="26" Height="1" Background="{DynamicResource Border}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource IconBtn}" Width="42" Height="42"
                                    Click="ThemeToggle_Click" ToolTip="切换浅色 / 深色">
                                <TextBlock x:Name="ThemeGlyph" Text="&#xE706;"
                                           FontFamily="{StaticResource IconFont}" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Width="42" Height="42"
                                    Click="NavSettings_Click" ToolTip="设置">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                            </Button>
                            <Border Width="28" Height="28" CornerRadius="9" Margin="0,6,0,0"
                                    Background="{DynamicResource AccentSoft}">
                                <TextBlock Text="极" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 主区 ===== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <!-- ================= 队列 ================= -->
                        <Grid x:Name="ViewTasks">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 捕获区 -->
                            <Border Grid.Row="0" Style="{StaticResource CardBox}"
                                    Margin="22,18,22,0" Padding="14,14,14,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="CapBox" Height="56" CornerRadius="12"
                                                Background="{DynamicResource Surface2}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="16" Foreground="{DynamicResource Dim}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="UrlBox" Style="{StaticResource CaptureInput}"
                                                             TextChanged="UrlBox_TextChanged" KeyDown="UrlBox_KeyDown"/>
                                                    <TextBlock x:Name="UrlHint" IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Dim}" FontSize="13.5"
                                                               Text="粘贴链接，自动识别来源与类型"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Border BorderBrush="{DynamicResource BorderHover}" BorderThickness="1"
                                                            CornerRadius="5" Padding="5,1" Background="{DynamicResource Card}">
                                                        <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Dim}"/>
                                                    </Border>
                                                    <Border BorderBrush="{DynamicResource BorderHover}" BorderThickness="1"
                                                            CornerRadius="5" Padding="5,1" Margin="3,0,0,0"
                                                            Background="{DynamicResource Card}">
                                                        <TextBlock Text="V" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Dim}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Button Grid.Column="1" Style="{StaticResource Chip}" Height="34" Margin="10,0,0,0"
                                                Click="PickTargetFolder_Click" ToolTip="选择保存位置">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TargetChipText" Text="自动归类" FontSize="12.5"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="8" Margin="8,1,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Dim}"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Style="{StaticResource PrimaryLg}" Margin="10,0,0,0"
                                                Click="AddTask_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="开始下载" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 识别结果 / 提示 -->
                                    <Grid Margin="2,10,2,0" MinHeight="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <TextBlock x:Name="CapDefaultHint"
                                                       Text="支持 HuggingFace · Civitai · 直链 · 磁力链接，拖入 .torrent 也可开始"
                                                       FontSize="11.5" Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=InfoText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock x:Name="InfoText" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="保存到" FontSize="11.5"
                                                       Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CapTargetText" Text="models" FontSize="11.5"
                                                       Foreground="{DynamicResource Sub}" Margin="5,0,0,0"
                                                       MaxWidth="360" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 磁力 / BT：识别到 magnet 时才出现 -->
                                    <Border x:Name="MagStrip" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="磁力链接 / BT" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock x:Name="BtDirText" Style="{StaticResource DimText}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Border x:Name="BtProgressCard" Visibility="Collapsed" Margin="0,8,0,0"
                                                        Background="{DynamicResource Card}" CornerRadius="8" Padding="10,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                                       FontWeight="SemiBold" Margin="0,0,90,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border HorizontalAlignment="Right"
                                                                    Style="{StaticResource StatusPill}"
                                                                    Tag="{Binding StatusKind}">
                                                                <TextBlock Text="{Binding StatusText}"/>
                                                            </Border>
                                                        </Grid>
                                                        <ProgressBar Height="4" Margin="0,8,0,6" Maximum="100"
                                                                     Value="{Binding Pct}" Style="{StaticResource ProgressRow}"/>
                                                        <Grid>
                                                            <TextBlock Text="{Binding SizeLine}" Style="{StaticResource DimText}"
                                                                       FontFamily="{StaticResource MonoFont}"/>
                                                            <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource Sub}" FontSize="11.5"
                                                                       FontFamily="{StaticResource MonoFont}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtStopBtn" Content="停止" Style="{StaticResource Ghost}"
                                                        Margin="0,0,8,0" Click="BtStop_Click" IsEnabled="False"/>
                                                <Button x:Name="BtStartBtn" Content="开始下载"
                                                        Style="{StaticResource Primary}" Click="BtStart_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 队列工具条 -->
                            <Grid Grid.Row="1" Margin="24,16,22,8" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="队列" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="5"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text, ElementName=CountAll}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Sub}"/>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SegmentedBar}" Margin="14,0,0,0" Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabAll" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     IsChecked="True" Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="全部"/>
                                                <TextBlock x:Name="CountAll" Text="0" Margin="5,0,0,0" FontSize="10.5"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabActive" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="下载中"/>
                                                <TextBlock x:Name="CountActive" Text="0" Margin="5,0,0,0" FontSize="10.5"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabDone" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="已完成"/>
                                                <TextBlock x:Name="CountDone" Text="0" Margin="5,0,0,0" FontSize="10.5"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabPaused" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="已停止"/>
                                                <TextBlock x:Name="CountPaused" Text="0" Margin="5,0,0,0" FontSize="10.5"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <ComboBox x:Name="SortCombo" Grid.Column="4" Style="{StaticResource DarkCombo}"
                                          Width="112" VerticalAlignment="Center">
                                    <ComboBoxItem Content="按添加时间"/>
                                    <ComboBoxItem Content="按名称"/>
                                    <ComboBoxItem Content="按进度"/>
                                </ComboBox>
                                <Button Grid.Column="5" Style="{StaticResource IconBtn}" Margin="4,0,0,0"
                                        Click="ToggleLog_Click" ToolTip="运行日志">
                                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                </Button>
                            </Grid>

                            <!-- 任务列表 -->
                            <Border Grid.Row="2" Margin="22,0,22,14" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="14" ClipToBounds="True">
                                <Grid>
                                    <ListBox x:Name="TaskList" Background="Transparent" BorderThickness="0"
                                             ItemTemplateSelector="{StaticResource RowSelector}"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             Padding="0,2"
                                             IsSynchronizedWithCurrentItem="False"
                                             ItemContainerStyle="{StaticResource RowItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             SelectionChanged="TaskList_SelectionChanged">
                                        <ListBox.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource QueueGroupHost}">
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="18,14,0,5">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource QueueGroupHeader}" Margin="0"/>
                                                            <Border Background="{DynamicResource Surface3}" CornerRadius="4"
                                                                    Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Sub}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                    </ListBox>

                                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Border Width="52" Height="52" CornerRadius="16"
                                                Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                       Foreground="{DynamicResource Dim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="队列是空的" Margin="0,14,0,0" FontSize="13"
                                                   Foreground="{DynamicResource Sub}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="把链接粘到上面的输入框，或直接把链接拖进窗口"
                                                   Style="{StaticResource DimText}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================= 历史 ================= -->
                        <Grid x:Name="ViewHistory" Visibility="Collapsed" Margin="22,18,22,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="历史" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="HistorySubText" Text="完成、失败、已停止的任务都在这里"
                                               Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="导出 CSV" Style="{StaticResource TextBtn}" Click="ExportHistory_Click"/>
                                    <Button Content="清空历史" Style="{StaticResource DangerGhost}"
                                            Click="ClearHistory_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBox}" Padding="14,12" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="记录条数" Style="{StaticResource MicroLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="StatCount" Text="0" FontSize="22" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Text="条" FontSize="11.5" Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="14,12" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="累计下载" Style="{StaticResource MicroLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="StatBytes" Text="0 B" FontSize="22" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFont}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource CardBox}" Padding="14,12" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="完成率" Style="{StaticResource MicroLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="StatRate" Text="--" FontSize="22" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFont}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="14" ClipToBounds="True">
                                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0,2"
                                         IsSynchronizedWithCurrentItem="False"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Standard">
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MicroLabel}"
                                                               Margin="16,12,0,6"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,0,14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="66"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}">
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FileName}"/>
                                                    <TextBlock Text="{Binding TargetLine}" FontSize="11"
                                                               Foreground="{DynamicResource Dim}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DestPath}"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding HostShort}" FontSize="11"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="11.5"
                                                           Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"/>

                                                <Border Grid.Column="4" Style="{StaticResource StatusPill}"
                                                        Tag="{Binding StatusKind}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StatusText}"/>
                                                </Border>

                                                <TextBlock Grid.Column="5" Text="{Binding AddedAt, StringFormat='{}{0:HH:mm}'}"
                                                           FontSize="11" Foreground="{DynamicResource Dim}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- ================= 模型库 ================= -->
                        <Grid x:Name="ViewFolder" Visibility="Collapsed" Margin="22,18,22,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="模型库" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="FolderPathText" Style="{StaticResource DimText}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="重新扫描" Style="{StaticResource TextBtn}" Click="RefreshFolders_Click"/>
                                    <Button Content="在资源管理器打开" Style="{StaticResource TextBtn}"
                                            Click="OpenModelsDir_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource Card}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="14" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="16,0,14,0">
                                            <TextBlock Text="目录" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                                            <TextBlock Text="大小" Style="{StaticResource MicroLabel}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource BorderSoft}"/>
                                        <ListBox x:Name="FolderList" Grid.Row="1" Background="Transparent"
                                                 BorderThickness="0" Padding="0,2"
                                                 IsSynchronizedWithCurrentItem="True"
                                                 ItemContainerStyle="{StaticResource FlatItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="FolderList_DoubleClick"
                                                 SelectionChanged="FolderList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,0,14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="13" Foreground="{DynamicResource Dim}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                                   Margin="9,0,8,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                                   Foreground="{DynamicResource Dim}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource Card}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="14" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="16,0,14,0">
                                            <TextBlock x:Name="LibTitle" Text="文件" Style="{StaticResource MicroLabel}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LibSummary" Style="{StaticResource MicroLabel}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource BorderSoft}"/>
                                        <ListBox x:Name="LibFileList" Grid.Row="1" Background="Transparent"
                                                 BorderThickness="0" Padding="0,2"
                                                 ItemContainerStyle="{StaticResource FlatItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="LibFileList_DoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,0,14,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="86"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FullPath}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Sub}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFont}"/>
                                                        <Border Grid.Column="2" Style="{StaticResource StatusPill}"
                                                                Tag="done" Margin="12,0,0,0">
                                                            <TextBlock Text="已校验"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ============================================================
                             详情抽屉：覆盖式，不占列表宽度
                             ============================================================ -->
                        <Border x:Name="ScrimLayer" Background="{DynamicResource Scrim}"
                                Visibility="Collapsed" Panel.ZIndex="24"
                                MouseLeftButtonDown="ScrimLayer_Click"/>

                        <Border x:Name="DetailPanel" Width="364" HorizontalAlignment="Right"
                                Panel.ZIndex="26" Visibility="Collapsed"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DrawerShift" X="364"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.16" Color="{DynamicResource Shadow}"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="18,0,10,0">
                                    <TextBlock Text="任务详情" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="CloseDrawer_Click" ToolTip="收起 (Esc)">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                        Background="{DynamicResource BorderSoft}"/>

                                <ScrollViewer x:Name="PanelDetail" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              Padding="18,16,16,20"
                                              DataContext="{Binding SelectedItem, ElementName=TaskList}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="11"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxHeight="54"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TargetLine}" FontSize="11.5"
                                                           Foreground="{DynamicResource Dim}" Margin="0,5,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,18,0,0">
                                            <TextBlock Text="{Binding PctText}" FontSize="22" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFont}" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding SizeLine}" FontSize="11.5"
                                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,3"
                                                       FontFamily="{StaticResource MonoFont}"/>
                                        </Grid>
                                        <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100"
                                                     Value="{Binding Pct, Mode=OneWay}" Background="{DynamicResource TrackBg}"/>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Style="{StaticResource StatTile}">
                                                <StackPanel>
                                                    <TextBlock Text="下载速度" Style="{StaticResource MicroLabel}"/>
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="14"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                                <StackPanel>
                                                    <TextBlock Text="剩余时间" Style="{StaticResource MicroLabel}"/>
                                                    <TextBlock Text="{Binding EtaText}" FontSize="14"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Style="{StaticResource StatTile}">
                                                <StackPanel>
                                                    <TextBlock Text="文件大小" Style="{StaticResource MicroLabel}"/>
                                                    <TextBlock Text="{Binding TotalText}" FontSize="14"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource StatTile}">
                                                <StackPanel>
                                                    <TextBlock Text="来源" Style="{StaticResource MicroLabel}"/>
                                                    <TextBlock Text="{Binding HostShort}" FontSize="14"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="保存位置" Style="{StaticResource MicroLabel}" Margin="2,20,0,7"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="9"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DestPath, Converter={StaticResource PathWrap}}" FontSize="11"
                                                           Foreground="{DynamicResource Sub}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           TextWrapping="Wrap"
                                                           ToolTip="{Binding DestPath}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconBtn}"
                                                        Width="24" Height="24" Margin="8,0,0,0"
                                                        Click="OpenTaskFolder_Click" ToolTip="{Binding FolderHint}">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="操作" Style="{StaticResource MicroLabel}" Margin="2,20,0,7"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="停止" Style="{StaticResource Primary}" Height="32"
                                                    FontSize="12" Click="CancelTask_Click"
                                                    Visibility="{Binding IsActive, Converter={StaticResource B2V}}"/>
                                            <Button Content="继续" Style="{StaticResource Primary}" Height="32"
                                                    FontSize="12" Click="ResumeTask_Click"
                                                    Visibility="{Binding CanResume, Converter={StaticResource B2V}}"/>
                                            <Button Content="复制链接" Style="{StaticResource Ghost}" Height="32"
                                                    FontSize="12" Margin="8,0,0,0" Click="CopyLink_Click"/>
                                            <Button Content="删除" Style="{StaticResource DangerGhost}" Height="32"
                                                    FontSize="12" Margin="4,0,0,0" Click="RemoveTask_Click"/>
                                        </StackPanel>

                                        <TextBlock Text="下载来源" Style="{StaticResource MicroLabel}" Margin="2,20,0,7"/>
                                        <Border Background="{DynamicResource Surface2}" CornerRadius="9"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,8">
                                            <TextBlock Text="{Binding SourceText}" FontSize="11"
                                                       Foreground="{DynamicResource Sub}"
                                                       TextWrapping="Wrap" MaxHeight="48"
                                                       ToolTip="{Binding SourceText}"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ============================================================
                             运行日志：底部全局抽屉
                             ============================================================ -->
                        <Border x:Name="PanelLog" Height="252" VerticalAlignment="Bottom"
                                Panel.ZIndex="28" Visibility="Collapsed"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LogShift" Y="252"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.14" Color="{DynamicResource Shadow}"/>
                            </Border.Effect>

                            <Grid Margin="20,12,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="最近 500 条 · 自动滚到最新" Style="{StaticResource DimText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="清空" Style="{StaticResource TextBtn}" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource IconBtn}" Click="CloseLog_Click" ToolTip="收起">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource Surface2}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="12,10,6,10">
                                    <Grid>
                                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10" Foreground="{DynamicResource Dim}"
                                                                   Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="LogEmpty" Text="暂无日志" Style="{StaticResource DimText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============================================================
                             设置：780 × 552 模态
                             ============================================================ -->
                        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Panel.ZIndex="60"
                              Background="{DynamicResource Scrim}" MouseLeftButtonDown="SettingsOverlay_Click">
                            <Border Width="780" Height="552" Background="{DynamicResource Card}" CornerRadius="16"
                                    MouseLeftButtonDown="SettingsSheet_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.30"
                                                      Color="{DynamicResource Shadow}"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 子导航 -->
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="16,0,0,16">
                                        <StackPanel Margin="10,14,10,10">
                                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,12"/>

                                            <RadioButton x:Name="SubNavPath" Style="{StaticResource SubNav}"
                                                         GroupName="SubNav" IsChecked="True" Checked="SubNav_Checked" Tag="path">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="保存位置" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="SubNavBehavior" Style="{StaticResource SubNav}"
                                                         GroupName="SubNav" Checked="SubNav_Checked" Tag="behavior">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="下载行为" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="SubNavEngine" Style="{StaticResource SubNav}"
                                                         GroupName="SubNav" Checked="SubNav_Checked" Tag="engine">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="下载引擎" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="SubNavLook" Style="{StaticResource SubNav}"
                                                         GroupName="SubNav" Checked="SubNav_Checked" Tag="look">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="外观" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>

                                            <Border Height="1" Background="{DynamicResource Border}" Margin="9,12,9,12"/>

                                            <Button Style="{StaticResource TextBtn}" HorizontalAlignment="Left"
                                                    Click="OpenModelsDir_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="打开模型目录" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- 内容 -->
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="52"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="56"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="20,0,12,0">
                                            <TextBlock x:Name="SheetTitle" Text="保存位置" FontSize="14"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Click="CloseSettings_Click">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource BorderSoft}"/>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                                            <Grid>
                                                <!-- 保存位置 -->
                                                <StackPanel x:Name="PanePath">
                                                    <TextBlock Text="目录" Style="{StaticResource MicroLabel}" Margin="2,0,0,8"/>
                                                    <Border Style="{StaticResource SettingCard}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="模型文件" FontSize="12.5" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="safetensors / gguf / ckpt / pt / pth / onnx"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <TextBox x:Name="ModelsDirBox" Grid.Column="1" Height="30" FontSize="11"
                                                                             Margin="0,0,8,0" HorizontalAlignment="Stretch"
                                                                             FontFamily="{StaticResource MonoFont}"/>
                                                                    <Button Grid.Column="2" Content="浏览" Style="{StaticResource MiniBtn}"
                                                                            Click="BrowseModelsDir_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="其他文件" FontSize="12.5" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="软件 / 压缩包 / 镜像 / 视频 / 文档 …"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBox x:Name="DownloadDirBox" Grid.Column="1" Height="30" FontSize="11"
                                                                             Margin="0,0,8,0" HorizontalAlignment="Stretch"
                                                                             FontFamily="{StaticResource MonoFont}"/>
                                                                    <Button Grid.Column="2" Content="浏览" Style="{StaticResource MiniBtn}"
                                                                            Click="BrowseDownloadDir_Click"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="归类规则" Style="{StaticResource MicroLabel}" Margin="2,18,0,8"/>
                                                    <Border Style="{StaticResource SettingCard}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text=".safetensors / .ckpt" FontSize="12.5"/>
                                                                        <TextBlock Text="读元数据判断类型，失败时按文件名关键词归类"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}" Tag="done">
                                                                        <TextBlock Text="自动"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text=".gguf / .pt / .pth" FontSize="12.5"/>
                                                                        <TextBlock Text="优先 text_encoders，其次 unet"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}" Tag="done">
                                                                        <TextBlock Text="自动"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 下载行为 -->
                                                <StackPanel x:Name="PaneBehavior" Visibility="Collapsed">
                                                    <Border Style="{StaticResource SettingCard}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="同时下载" FontSize="12.5"/>
                                                                        <TextBlock Text="超出的任务自动排队"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ComboBox x:Name="ConcurrentCombo" Style="{StaticResource BoxCombo}"
                                                                              Width="168" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              SelectionChanged="BehaviorCombo_Changed">
                                                                        <ComboBoxItem Content="1 个"/>
                                                                        <ComboBoxItem Content="2 个"/>
                                                                        <ComboBoxItem Content="3 个"/>
                                                                        <ComboBoxItem Content="不限"/>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="全局限速" FontSize="12.5"/>
                                                                        <TextBlock Text="限制总带宽，不影响其他程序"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ComboBox x:Name="SpeedLimitCombo" Style="{StaticResource BoxCombo}"
                                                                              Width="168" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              SelectionChanged="BehaviorCombo_Changed">
                                                                        <ComboBoxItem Content="不限速"/>
                                                                        <ComboBoxItem Content="1 MB/s"/>
                                                                        <ComboBoxItem Content="2 MB/s"/>
                                                                        <ComboBoxItem Content="5 MB/s"/>
                                                                        <ComboBoxItem Content="10 MB/s"/>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="代理" FontSize="12.5"/>
                                                                        <TextBlock Text="只对下载引擎生效；留空表示不用"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBox x:Name="ProxyBox" Width="200" Height="30" FontSize="11"
                                                                             FontFamily="{StaticResource MonoFont}"
                                                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                             ToolTip="例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7890"
                                                                             TextChanged="ProxyBox_TextChanged"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="同名文件" FontSize="12.5"/>
                                                                        <TextBlock Text="目标位置已有同名文件时怎么办"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ComboBox x:Name="ConflictCombo" Style="{StaticResource BoxCombo}"
                                                                              Width="168" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              SelectionChanged="BehaviorCombo_Changed">
                                                                        <ComboBoxItem Content="每次询问"/>
                                                                        <ComboBoxItem Content="直接覆盖"/>
                                                                        <ComboBoxItem Content="跳过"/>
                                                                        <ComboBoxItem Content="重命名保存"/>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="下载前检查磁盘空间" FontSize="12.5"/>
                                                                        <TextBlock Text="空间不够提前提示，避免下到一半失败"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox x:Name="DiskCheckSwitch" Style="{StaticResource Switch}"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              Click="DiskCheckSwitch_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="新建任务时询问保存位置" FontSize="12.5"/>
                                                                        <TextBlock Text="关闭后按归类规则直接存入"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox x:Name="AskFolderSwitch" Style="{StaticResource Switch}"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              Click="AskFolderSwitch_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="下载前多源测速" FontSize="12.5"/>
                                                                        <TextBlock Text="hf / hf-mirror / modelscope 挑最快的"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox x:Name="RaceSwitch" Style="{StaticResource Switch}"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              Click="ToggleSetting_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="连接数" FontSize="12.5"/>
                                                                        <TextBlock Text="自动实测 1 / 4 / 16 连接，谁快用谁"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ComboBox x:Name="ConnCombo" Style="{StaticResource BoxCombo}"
                                                                              Width="168" HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              SelectionChanged="ConnCombo_SelectionChanged">
                                                                        <ComboBoxItem Content="自动（测速选最快）"/>
                                                                        <ComboBoxItem Content="4 线程"/>
                                                                        <ComboBoxItem Content="8 线程"/>
                                                                        <ComboBoxItem Content="16 线程"/>
                                                                        <ComboBoxItem Content="32 线程"/>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="完成后校验 safetensors" FontSize="12.5"/>
                                                                        <TextBlock Text="检查文件头与数据区是否完整"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox x:Name="VerifySwitch" Style="{StaticResource Switch}"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              Click="ToggleSetting_Click"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 下载引擎 -->
                                                <StackPanel x:Name="PaneEngine" Visibility="Collapsed">
                                                    <TextBlock Text="更新" Style="{StaticResource MicroLabel}" Margin="2,0,0,8"/>
                                                    <Border Background="{DynamicResource Surface2}" CornerRadius="10"
                                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                            Padding="14,12" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <Grid>
                                                                <StackPanel>
                                                                    <TextBlock Text="当前版本" FontSize="12.5"/>
                                                                    <TextBlock x:Name="VersionLine" Text="v1.0.0"
                                                                               Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Button Content="检查更新" Style="{StaticResource MiniBtn}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                        Click="CheckUpdate_Click"/>
                                                            </Grid>
                                                            <TextBlock Text="更新源（version.json 地址，留空则不检查）"
                                                                       Style="{StaticResource DimText}" Margin="0,12,0,6"/>
                                                            <TextBox x:Name="UpdateFeedBox" Height="30" FontSize="11"
                                                                     FontFamily="{StaticResource MonoFont}"
                                                                     ToolTip="例如 https://raw.githubusercontent.com/用户/仓库/main/version.json"
                                                                     TextChanged="UpdateFeedBox_TextChanged"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="当前引擎" Style="{StaticResource MicroLabel}" Margin="2,0,0,8"/>
                                                    <Border Background="{DynamicResource Surface2}" CornerRadius="10"
                                                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,12">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="aria2c" FontSize="12.5" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="AriaSourceText" Style="{StaticResource DimText}"
                                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                <Border Style="{StaticResource StatusPill}" Tag="done"
                                                                        HorizontalAlignment="Right">
                                                                    <TextBlock Text="运行中"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock x:Name="AriaText" Style="{StaticResource DimText}"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                                       TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0"/>
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Button x:Name="AriaOpenBtn" Content="打开所在位置"
                                                                        Style="{StaticResource MiniBtn}" Click="AriaOpen_Click"/>
                                                                <Button Content="复制路径" Style="{StaticResource MiniBtn}"
                                                                        Margin="6,0,0,0" Click="AriaCopy_Click"/>
                                                                <Button Content="更换引擎…" Style="{StaticResource MiniBtn}"
                                                                        Margin="6,0,0,0" Click="AriaPick_Click"/>
                                                                <Button x:Name="AriaPortableBtn" Content="复制到软件目录"
                                                                        Style="{StaticResource MiniBtn}" Margin="6,0,0,0"
                                                                        Click="AriaPortable_Click"/>
                                                                <Button x:Name="AriaResetBtn" Content="恢复自动检测"
                                                                        Style="{StaticResource MiniBtn}" Margin="6,0,0,0"
                                                                        Click="AriaReset_Click"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="查找顺序" Style="{StaticResource MicroLabel}" Margin="2,18,0,8"/>
                                                    <Border Style="{StaticResource SettingCard}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <StackPanel>
                                                                    <TextBlock Text="1 · 自定义路径" FontSize="12.5"/>
                                                                    <TextBlock Text="未设置" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="2 · 程序同目录" FontSize="12.5"/>
                                                                        <TextBlock Text="便携优先，整个文件夹可直接拷走"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}" Tag="done">
                                                                        <TextBlock Text="命中"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                                <StackPanel>
                                                                    <TextBlock Text="3 · winget / 系统目录 / PATH" FontSize="12.5"/>
                                                                    <TextBlock Text="兜底" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 外观 -->
                                                <StackPanel x:Name="PaneLook" Visibility="Collapsed">
                                                    <Border Style="{StaticResource SettingCard}">
                                                        <StackPanel>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="深色模式" FontSize="12.5"/>
                                                                        <TextBlock Text="整个界面切换为深色配色"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox x:Name="ThemeSwitch" Style="{StaticResource Switch}"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              Click="ThemeSwitch_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="关闭窗口时" FontSize="12.5"/>
                                                                        <TextBlock Text="有任务进行中时的行为"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <ComboBox Style="{StaticResource BoxCombo}" Width="140"
                                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                              SelectedIndex="0">
                                                                        <ComboBoxItem Content="最小化到托盘"/>
                                                                        <ComboBoxItem Content="直接退出"/>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </Border>
                                                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                                                <Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="界面框架" FontSize="12.5"/>
                                                                        <TextBlock Text="C# / WPF (.NET 9) 原生 Windows 客户端"
                                                                                   Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>

                                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                                            <Grid Margin="20,0,16,0">
                                                <Button Content="恢复默认" Style="{StaticResource TextBtn}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Click="ResetSettings_Click"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Content="取消" Style="{StaticResource Ghost}"
                                                            Click="CloseSettings_Click"/>
                                                    <Button Content="完成" Style="{StaticResource Primary}"
                                                            Height="32" Margin="8,0,0,0" Click="SaveSettings_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============================================================
                         底部仪表：常驻，切页也不消失
                         ============================================================ -->
                    <Border Grid.Row="1" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Green}" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBlock x:Name="SpeedBig" Text="0.0" FontSize="15" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SpeedUnit" Text="MB/s" FontSize="10.5"
                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                           Margin="4,0,0,1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="18,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock x:Name="UpText" Text="0.0 MB/s" FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="18,0,0,0">
                                <TextBlock Text="剩余" FontSize="11.5" Foreground="{DynamicResource Dim}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="EtaText" Text="--" FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                                <Border x:Name="UpdatePill" Visibility="Collapsed" Margin="10,0,0,0"
                                        Padding="8,2" Background="{DynamicResource AccentSoft}"
                                        CornerRadius="6" Cursor="Hand" VerticalAlignment="Center"
                                        ToolTip="点击打开下载页"
                                        MouseLeftButtonUp="UpdatePill_Click">
                                    <TextBlock x:Name="UpdatePillText" Text="新版本" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <Border x:Name="LimitPill" Visibility="Collapsed" Margin="16,0,0,0"
                                        Background="{DynamicResource WarnSoft}" CornerRadius="6"
                                        Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="LimitPillText" Text="限速" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Amber}"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Column="3" Margin="18,0,18,0">
                                <ctrl:Sparkline x:Name="SpeedChart" Height="24" VerticalAlignment="Center"
                                                HorizontalAlignment="Left" Width="150"
                                                LineBrush="{DynamicResource Accent}">
                                    <ctrl:Sparkline.FillBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#332B5CFF" Offset="0"/>
                                            <GradientStop Color="#002B5CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ctrl:Sparkline.FillBrush>
                                </ctrl:Sparkline>
                            </Grid>

                            <TextBlock x:Name="SbRight" Grid.Column="4" Text="0 进行中 · 共 0 项"
                                       FontSize="11.5" Foreground="{DynamicResource Dim}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
